# ─────────────────────────────────────────────────────────────
# Agent OS (Hermes OS) — Environment Template.
# Copy to .env and configure.
# ─────────────────────────────────────────────────────────────

# --- Model Providers ---
# GEMINI_API_KEY is used for Antigravity (Daedalus), Gemini Direct (Apollo), and Hermes (Cognition).
GEMINI_API_KEY=
# ANTHROPIC_API_KEY is used exclusively for Claude Code (Hephaestus) and Claude direct (Athena).
ANTHROPIC_API_KEY=

# --- Hermes core (Nous Research Hermes) via the mcpo REST bridge ---
# Exposes standard tools of the active Hermes agent.
HERMES_MCP_URL=http://10.10.10.108:9200
HERMES_MCP_API_KEY=

# --- Memory OS (READ-ONLY) ---
# Qdrant runs on the Proxmox host bridge.
QDRANT_URL=http://10.10.10.140:6333
QDRANT_COLLECTION=knowledge_base
# Read-only path to bind-mounted LXC102's .hermes home
HERMES_HOME_RO=

# --- Agent OS Internal Services ---
# If AGENT_OS_AUTH_TOKEN is provided, backend requests require the X-Agent-OS-Token header.
# For local dev without a token, leave blank.
AGENT_OS_AUTH_TOKEN=
POSTGRES_USER=agentos
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_DB=agentos
DATABASE_URL=postgresql+asyncpg://agentos:change-me-in-dev@postgres:5432/agentos
REDIS_URL=redis://redis:6379/0

# --- Web Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_AGENT_OS_TOKEN=
